# ===== BrandSentinel server configuration =====
# Copy this file to server/.env for local use. On Render/Vercel set the same names in the dashboard (never commit real values).

# --- Required in production ---
NODE_ENV=development
# MongoDB Atlas connection string (replace the placeholders; URL-encode special characters in the password)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=brandsentinel
# Random strings, at least 32 characters each. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CERT_SECRET=

# --- Optional: hosted AI assistant (both have free tiers). Leave empty to run rules-only. ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional ---
PORT=4000
# Allow your separately hosted frontend (e.g. Vercel). Comma-separated. Not needed when Render serves the UI.
CLIENT_ORIGIN=
# Load the NovaBrew demo organisation when the database is empty
SEED_DEMO=true
# Let anyone create a new organisation from the login page
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=10
SLACK_WEBHOOK_URL=
OCR_ENABLED=false
